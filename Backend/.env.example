# ─── Server ───────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB ──────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/healthsync
MONGO_URI_TEST=mongodb://localhost:27017/healthsync_test

# ─── JWT Secrets (minimum 64 random characters each) ─────
ACCESS_TOKEN_SECRET=your_access_token_secret_here_min_64_chars_xxxxxxxxxxxxxxxxxxxxxxxx
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here_min_64_chars_xxxxxxxxxxxxxxxxxxxxxxx

# ─── Frontend URL (for CORS) ─────────────────────────────
CLIENT_URL=http://localhost:3000

# ─── SMTP Email Settings (Optional) ────────────────────────
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM="HealthSync <no-reply@healthsync.com>"

# ─── File Uploads ─────────────────────────────────────────
UPLOAD_DIR=uploads
# NOTE: scanned report PDFs are NEVER written here. They are parsed in memory
# and discarded — only the extracted recommendation sentence is retained.

# ─── Follow-up Obligations (clinical loop closure) ────────
# How often the scheduler sweeps for due/overdue follow-ups.
# Default 3600000 (hourly). Drop to 60000 when demoing.
FOLLOWUP_SWEEP_INTERVAL_MS=3600000

# ─── OCR (photos & scanned PDFs) ──────────────────────────
# The English language model is installed as an npm dependency
# (@tesseract.js-data/eng) and resolved from node_modules, so OCR works fully
# offline. Nothing is fetched from a CDN at runtime.
#
# All optional — the defaults below are what ship.
OCR_TIMEOUT_MS=45000          # abort a single image that takes too long
OCR_MAX_CONCURRENT=2          # OCR is CPU-bound; extra jobs queue, not compete
OCR_IDLE_TEARDOWN_MS=300000   # free the ~50 MB worker after 5 min idle
OCR_MIN_CONFIDENCE=55         # below this the read is flagged as unreliable
OCR_MAX_INPUT_PIXELS=40000000 # decompression-bomb guard (file size can't bound this)
OCR_MAX_PDF_PAGES=10          # pages rasterized+OCR'd from a scanned PDF

# Folder / multi-page uploads. The aggregate cap is enforced separately from
# the 15 MB per-file cap — 25 files of 14 MB each passes every per-file check
# and is still 350 MB of buffers held in memory at once.
SCAN_MAX_BATCH_FILES=25
SCAN_MAX_BATCH_BYTES=62914560  # 60 MB

# ─── AI Medical Text Analysis ──────────────────────────────
# Powers the plain-English record summarizer, lab metric explainer,
# and structured medication extraction from OCR text.
#
# ⚠ Setting these sends report text — which is PHI — to a third party.
# Only enable with a provider you have a data processing agreement with.
#
# Supports any OpenAI-compatible chat completion API (Gemini, OpenAI, Ollama).
# Leave AI_API_KEY blank to disable AI features entirely — records will still
# be created and OCR will still work, just without AI summaries.
AI_API_KEY=
AI_MODEL=gemini-2.5-flash
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
AI_TIMEOUT_MS=30000

# Optional LLM extraction. Leave BLANK to use the built-in rule-based
# extractor, which needs no key, no network, and is fully deterministic.
#
# ⚠ Setting these sends report text — which is PHI — to a third party.
# Only enable with a provider you have a data processing agreement with.
# Implement the provider call in src/services/extractors/llmExtractor.js.
FOLLOWUP_LLM_PROVIDER=
FOLLOWUP_LLM_API_KEY=
FOLLOWUP_LLM_MODEL=
FOLLOWUP_LLM_BASE_URL=
FOLLOWUP_LLM_TIMEOUT_MS=15000

# ─── Admin Bootstrap (used ONLY by `npm run seed:admin`) ───
# There is no public admin sign-up endpoint by design — admin accounts are
# provisioned by running scripts/seedAdmin.js with these set. Treat these as
# one-time bootstrap values, not the account's real password:
#   1. Set them here (or inline on the command), run `npm run seed:admin`.
#   2. Log in once at /admin/login.
#   3. Change the password immediately and delete these four lines from your
#      local .env. Never commit real values for these.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_FIRST_NAME=
ADMIN_SEED_LAST_NAME=
ADMIN_SEED_MOBILE=
# ADMIN_SEED_ROLE=admin   # or 'superadmin'; defaults to 'admin'
